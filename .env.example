# Local development uses persistent PGlite in .data/ when DATABASE_URL is empty.
# On Vercel, DATABASE_URL is required. Use your Neon pooled connection string.
DATABASE_URL=

# Required on Vercel. Teachers enter this shared key when creating a new room.
# Use a long random value; do not prefix with NEXT_PUBLIC_.
TEACHER_ACCESS_KEY=

# Optional local database directory; never use PGlite on Vercel.
# PGLITE_DATA_DIR=.data/auction
