# Local development uses persistent PGlite in .data/ when DATABASE_URL is empty.
# On Vercel, DATABASE_URL is required. Use your Neon pooled connection string.
DATABASE_URL=

# Required on Vercel. Teachers enter this shared key when creating a new room.
# Use a long random value; do not prefix with NEXT_PUBLIC_.
TEACHER_ACCESS_KEY=

# Optional local database directory; never use PGlite on Vercel.
# PGLITE_DATA_DIR=.data/auction

# Local concurrency tests: only loopback PostgreSQL URLs are accepted.
# LOCAL_ONLY=1 prevents an accidental connection through DATABASE_URL.
# LOCAL_DATABASE_URL=postgresql://auction:local-auction-only@127.0.0.1:55433/auction_local
# LOCAL_ONLY=1
# Local timing diagnostics for test:load-local; disabled on Vercel/online DBs.
# LOCAL_PROFILE=1

# Optional online push listener: DIRECT PostgreSQL connection, not a pooler URL.
# Without this, each application process checks small revision counters once per
# second per active room and pushes changes via SSE. No client-wide full polling.
# REALTIME_DATABASE_URL=
